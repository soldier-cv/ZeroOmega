.page-header
  h2 {{'options_theme' | tr}}
section.settings-group
  h3 {{'options_themeBuiltin' | tr}}
  p.help-block {{'options_themeBuiltinHelp' | tr}}
  div.om-theme-list
    div.om-theme-card(ng-repeat='item in builtinThemes')
      div.om-theme-card-head
        span.om-theme-swatches
          span.om-theme-swatch(ng-repeat='color in item.colors'
            ng-style='{backgroundColor: color}')
        span.om-theme-card-name {{item.i18n | tr}}
      div.om-theme-card-actions
        button.btn.btn-default.btn-sm(type='button' role='button'
          ng-repeat='variant in item.variants'
          ng-click='changeTheme(variant.key)'
          ng-class='{"btn-primary": isCurrentTheme(variant.key)}')
          | {{variant.i18n | tr}}
  p.help-block
    | {{'options_themeAppliesEverywhere' | tr}}
section.settings-group
  h3 {{'options_themeOther' | tr}}
  p.help-block {{'options_themeOtherHelp' | tr}}
  select.form-control.width-limit(ng-model='selectedOtherTheme'
    ng-options='item.key as item.displayName for item in otherThemes track by item.key'
    ng-change='selectOtherTheme()')
    option(value='') {{'options_themeSelectPlaceholder' | tr}}
section.settings-group
  h3 {{'options_themeCustom' | tr}}
  p
    button.btn.btn-default(type='button' role='button' ng-click='changeTheme("")')
      span.glyphicon.glyphicon-remove
      = ' '
      | {{'options_themeClear' | tr}}
  p.help-block
    a(href='https://en.wikipedia.org/wiki/CSS' target='_blank')
      | {{'options_themeCssWiki' | tr}}
  textarea.monospace.form-control.width-limit(rows='30' spellcheck='false' ng-model='options["-customCss"]')
