.page-header
  h2 {{'about_title' | tr}}
section.omega-experimental(ng-show='isExperimental')
  p.alert.alert-warning
    span.glyphicon.glyphicon-warning-sign
    = ' '
    span {{'about_experimental_warning_moz' | tr}}
section
  .media(style='margin: 1em 0')
    .media-left
      img.media-object(src='img/icons/omega-action-32.png')
    .media-body
      h4.media-heading {{'appNameShort' | tr}}
      p {{'about_app_description' | tr}}
section
  p
    button.btn.btn-info(ng-click='reportIssue()' ladda='issueReporting')
      span.glyphicon.glyphicon-comment
      = ' '
      | {{'popup_reportIssues' | tr}}
    = ' '
    button.btn.btn-default(ng-click='downloadLog()' ladda='logDownloading' data-spinner-color="currentColor")
      span.glyphicon.glyphicon-download
      = ' '
      | {{'popup_errorLog' | tr}}
    = ' '
    button.btn.btn-danger(ng-click='showResetOptionsModal()' ladda='optionsReseting')
      span.glyphicon.glyphicon-alert
      = ' '
      | {{'options_reset' | tr}}
section
  p
    | {{'about_version' | tr:[version]}}
section.settings-group(ng-if='update')
  h3 {{'options_group_update' | tr}}
  p(ng-if='update.available')
    span.label.label-primary {{'options_updateAvailable' | tr:[update.latest]}}
  p(ng-if='!update.available && update.latest && !update.error')
    span.text-success
      span.glyphicon.glyphicon-ok
      = ' '
      | {{'options_updateLatest' | tr:[update.current]}}
  p.text-warning(ng-if='update.error')
    span.glyphicon.glyphicon-warning-sign
    = ' '
    | {{'options_updateFailed' | tr}}
    | {{' (' + update.error + ')'}}
  div(ng-if='update.available')
    ol.update-steps
      li {{'options_updateStepCopy' | tr}}
      li {{'options_updateStepRun' | tr}}
      li {{'options_updateStepReload' | tr}}
    pre.update-command {{update.command}}
  p
    button.btn.btn-primary(ng-if='update.available' ng-click='copyUpdateCommand()')
      span.glyphicon.glyphicon-copy
      = ' '
      | {{(updateCopied ? 'options_updateCopied' : 'options_updateCopy') | tr}}
    = ' '
    button.btn.btn-default(ng-if='update.available' ng-click='reloadExtension()')
      span.glyphicon.glyphicon-repeat
      = ' '
      | {{'options_updateReload' | tr}}
    = ' '
    button.btn.btn-default(ng-click='checkUpdate()' ladda='updateChecking'
      data-spinner-color="currentColor")
      span.glyphicon.glyphicon-refresh
      = ' '
      | {{'options_updateCheckNow' | tr}}
  p.help-block
    span.glyphicon.glyphicon-time
    = ' '
    | {{'options_updateAuto' | tr}}
    span(ng-if='update.checkedAt')
      = ' '
      | {{'options_updateLastChecked' | tr}}
      | {{update.checkedAt | date:'medium'}}
section
  p.text-warning
    span.glyphicon.glyphicon-info-sign
    = ' '
    span(ng-bind-html='"about_disclaimer_networkService" | tr')
  p.text-success
    span.glyphicon.glyphicon-eye-close
    = ' '
    span(ng-bind-html='"about_disclaimer_privacy" | tr')
  p.text-info
    span.glyphicon.glyphicon-question-sign
    = ' '
    span(ng-bind-html='"about_help" | tr')

section(style='margin-top: 7em')
  p
    | {{'appNameShort' | tr}}
    br
    span(ng-bind-html='"about_copyright" | tr')
    br
    span(ng-bind-html='"about_license" | tr')
    br
    span(ng-bind-html='"about_credits" | tr')
