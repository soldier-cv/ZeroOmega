.page-header
  h2 {{'options_tab_importExport' | tr}}
section.settings-group
  h3 {{'options_group_importExportProfile' | tr}}
  .help-block
    .text-info
      span.glyphicon.glyphicon-info-sign
      = ' '
      | {{'options_exportProfileHelp' | tr}}
section.settings-group
  h3 {{'options_group_importExportSettings' | tr}}
  p
    button.btn.btn-default(ng-click='exportOptions()')
      span.glyphicon.glyphicon-floppy-save
      = ' '
      | {{'options_makeBackup' | tr}}
    span.help-inline {{'options_makeBackupHelp' | tr}}
  p
    input#restore-local-file(type='file' omega-upload='restoreLocal($content)'
      omega-error='restoreLocalError($error)')
    button.btn.btn-default(ng-click='triggerFileInput()'
      ladda='restoringLocal' data-spinner-color="#000000")
      span.glyphicon.glyphicon-folder-open
      = ' '
      | {{'options_restoreLocal' | tr}}
    span.help-inline {{'options_restoreLocalHelp' | tr}}
section.settings-group
  h3 {{'options_group_webdavBackup' | tr}}
  form.backup-form
    div.form-group
      label {{'options_backupUri' | tr}}
      .input-group.width-limit
        span.input-group-addon {{'URI'}}
        input.form-control(type='text' ng-model='backupConfig.uri'
          placeholder="{{'options_backupUriPlaceholder' | tr}}")
    div.form-group
      label {{'options_backupUsername' | tr}}
      .input-group.width-limit
        span.input-group-addon {{'USER'}}
        input.form-control(type='text' ng-model='backupConfig.username'
          placeholder="{{'options_backupUsernamePlaceholder' | tr}}")
    div.form-group
      label {{'options_backupPassword' | tr}}
      .input-group.width-limit
        span.input-group-addon {{'PASS'}}
        input.form-control(type='password' ng-model='backupConfig.password'
          placeholder="{{'options_backupPasswordPlaceholder' | tr}}")
    div.checkbox
      label
        input#options-backup-auto(type='checkbox' ng-model='backupConfig.autoBackup'
          ng-change='backupAutoChanged()')
        span {{'options_backupAuto' | tr}}
      span.help-inline {{'options_backupAutoHelp' | tr}}
  p
    button.btn.btn-default(ng-click='saveBackupConfig()'
      ladda='savingBackupConfig' data-spinner-color="#000000")
      span.glyphicon.glyphicon-floppy-disk
      = ' '
      | {{'options_backupSave' | tr}}
    = ' '
    button.btn.btn-default(ng-click='backupNow()'
      ladda='backingUp' data-spinner-color="#000000")
      span.glyphicon.glyphicon-cloud-upload
      = ' '
      | {{'options_backupNow' | tr}}
    = ' '
    button.btn.btn-default(ng-click='restoreFromBackup()'
      ladda='restoringBackup' data-spinner-color="#000000")
      span.glyphicon.glyphicon-cloud-download
      = ' '
      | {{'options_backupRestore' | tr}}
  p.help-block
    span.glyphicon.glyphicon-time
    = ' '
    | {{'options_backupLast' | tr}}
    | {{ lastBackup ? (lastBackup | date:'medium') : ('options_backupLastNever' | tr) }}
    span(ng-if='lastBackupState')
      = ' '
      | {{'('}}
      | {{lastBackupState}}
      | {{')'}}
